# Public browser configuration. This is the only value here that may use the
# NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CONVEX_URL=

# Stable public origin of this Next.js deployment, without a trailing slash.
MCP_JWT_ISSUER=

# Generate these together with `pnpm generate:mcp-jwks`. Treat the private JWK
# and OAuth encryption key as secrets. Do not commit filled-in values.
MCP_JWT_KEY_ID=
MCP_JWT_PRIVATE_JWK=
MCP_JWT_PUBLIC_JWK=
MCP_OAUTH_ENCRYPTION_KEY=
